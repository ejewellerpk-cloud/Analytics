# Bake these for production so /connect is skipped (even Incognito).
# Values must match shop .env: APP_URL + VITE_API_KEY
# VITE_API_URL=https://ejeweller.pk
# VITE_LICENSE_KEY=your-shop-vite-api-key

# Or leave blank and use Shop Admin → Connect key (sz1.…) once per browser.
# Incognito always needs Connect key unless the two vars above are baked in.

# Local only: proxy /api when you set VITE_API_URL above
# VITE_DEV_USE_PROXY=true

VITE_ECHO_ENABLED=false
VITE_CURRENCY_SYMBOL=Rs
VITE_CURRENCY_DECIMALS=0
